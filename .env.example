# ---- Core (required) ----
DATABASE_URL="postgresql://lumera:lumera@localhost:5432/lumera?schema=public"
APP_URL="http://localhost:3000"
# Generate: openssl rand -base64 48   (min 32 chars). Never commit the real value.
AUTH_SECRET="change-me-change-me-change-me-change-me-change-me"

# ---- Seed ----
# true = on first start fill the empty database with DEMO data (20 masters, 5 studios). Set false once you use real data.
SEED_DEMO="false"
# ---- Docker only ----
DB_PASSWORD="lumera"
# DOMAIN="example.com"   # for HTTPS via Caddy

# ---- Seed (development only) ----
SEED_ADMIN_EMAIL="admin@lumera.test"
# Leave empty to get a random password printed once by `npm run db:seed`.
SEED_ADMIN_PASSWORD=""
# Password for all demo accounts (*.test e-mails). Required if NODE_ENV=production.
SEED_DEMO_PASSWORD="Demo12345!"

# ---- E-mail (Stage 3) ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Lumera <no-reply@example.com>"

# ---- Object storage, S3-compatible (Stage 3) ----
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL=""

# ---- Geocoding for the map (addresses -> coordinates) ----
# Default: public Nominatim/OpenStreetMap (free, ~1 req/s). Put a real contact e-mail here (their policy).
GEOCODER_EMAIL=""
# Optional: a paid geocoder with the same response shape
GEOCODER_URL=""

# ---- Billing cron (Stage 4) ----
# Call POST /api/cron/billing with header `Authorization: Bearer <CRON_SECRET>` once a day (cron, GitHub Actions, uptime pinger).
# Generate: openssl rand -base64 32
CRON_SECRET=""

# ---- Payments (Stage 4) ----
# Comma separated: test,stripe,liqpay,wayforpay. "test" is refused when NODE_ENV=production
# unless ALLOW_TEST_PAYMENTS=true.
PAYMENT_PROVIDERS="test"
ALLOW_TEST_PAYMENTS="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
LIQPAY_PUBLIC_KEY=""
LIQPAY_PRIVATE_KEY=""
WAYFORPAY_MERCHANT_ACCOUNT=""
WAYFORPAY_MERCHANT_SECRET=""
